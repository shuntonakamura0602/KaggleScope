# Public application URL used for canonical metadata and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:5173

# Added in Part 3 when PostgreSQL is introduced.
DATABASE_URL=

# Bearer token accepted by POST /api/revalidate after a successful ETL run.
REVALIDATE_SECRET=

# Used by the manual Meta Kaggle ETL introduced in Part 4.
KAGGLE_USERNAME=
KAGGLE_KEY=
# Alternatively, current Kaggle clients accept a single API token.
KAGGLE_API_TOKEN=
